# Copy to `.env` and fill in. Never commit `.env`.

# development | testing | production
SPEEDSPOT_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to SQLite at instance/speedspot.db
# DATABASE_URL=sqlite:////absolute/path/to/speedspot.db


# Development only: pretend your requests come from this public IP, to see provider
# detection working on localhost (127.0.0.1 has no provider). Ignored in production.
# SPEEDSPOT_DEV_CLIENT_IP=

# Behind a reverse proxy (e.g. one load balancer) set this to the number of proxies.
# TRUSTED_PROXY_COUNT=0

# Optional: custom path to the IP→ASN database (default data/asn/dbip-asn-lite.mmdb)
# ASN_DATABASE_PATH=

# Production only (see docs/DEPLOYMENT.md):
# DATABASE_URL=postgresql://user:password@host:5432/speedspot   (postgres:// is accepted too)
# RATELIMIT_STORAGE_URI=memory://    (use redis://… when running several instances)
# FORCE_HTTPS=true
# ALLOW_SQLITE_IN_PRODUCTION=false   (only with a persistent disk)
